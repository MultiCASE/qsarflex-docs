<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Draws the structures that appear in the PDFs, through ChemiGraphy, so the
    documents carry the product's own drawing and nothing else.

      dotnet run -c Release - - art.json ../../assets/art "#141414"

    ChemiGraphy.Embedded comes from the MultiCASE GitHub Packages feed
    (nuget.config beside this file; PRIVATE_NUGET_GITHUB_TOKEN in the
    environment). With a checkout of the ChemiGraphy repository to hand, build
    against it instead:  -p:ChemiGraphyRepo=/path/to/ChemiGraphy
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(ChemiGraphyRepo)' == ''">
    <PackageReference Include="ChemiGraphy.Embedded" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChemiGraphyRepo)' != ''">
    <ProjectReference Include="$(ChemiGraphyRepo)/src/ChemiGraphy.Embedded/ChemiGraphy.Embedded.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Indigo.Net" Version="1.43.0" />
  </ItemGroup>
</Project>
